generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  YOUTH
  COMPANY
  ADMIN
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique @db.VarChar(254)
  passwordHash        String              @map("password_hash") @db.VarChar(255)
  role                UserRole
  sessions            Session[]
  youthProfile        YouthProfile?
  companyProfile      CompanyProfile?
  reviewedValidations CompanyValidation[] @relation("ValidationReviewer")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model YouthProfile {
  firstName    String?
  lastName     String?
  birthDate    DateTime? @db.Date
  phone        String?
  cpf          String?   @unique @db.VarChar(11)
  postalCode   String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume       Resume?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("youth_profiles")
}

model Resume {
  id             String             @id @default(uuid()) @db.Uuid
  youthProfileId String             @unique @map("youth_profile_id") @db.Uuid
  youthProfile   YouthProfile       @relation(fields: [youthProfileId], references: [id], onDelete: Cascade)
  skills         ResumeSkill[]
  educations     ResumeEducation[]
  experiences    ResumeExperience[]
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("resumes")
}

model ResumeSkill {
  id       String @id @default(uuid()) @db.Uuid
  resumeId String @map("resume_id") @db.Uuid
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name     String @db.VarChar(100)

  @@unique([resumeId, name])
  @@map("resume_skills")
}

model ResumeEducation {
  id          String  @id @default(uuid()) @db.Uuid
  resumeId    String  @map("resume_id") @db.Uuid
  resume      Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  institution String  @db.VarChar(200)
  course      String  @db.VarChar(200)
  level       String  @db.VarChar(100)
  startMonth  String  @map("start_month") @db.VarChar(7)
  endMonth    String? @map("end_month") @db.VarChar(7)
  inProgress  Boolean @default(false) @map("in_progress")

  @@index([resumeId])
  @@map("resume_educations")
}

model ResumeExperience {
  id           String  @id @default(uuid()) @db.Uuid
  resumeId     String  @map("resume_id") @db.Uuid
  resume       Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  title        String  @db.VarChar(150)
  organization String  @db.VarChar(200)
  startMonth   String  @map("start_month") @db.VarChar(7)
  endMonth     String? @map("end_month") @db.VarChar(7)
  isCurrent    Boolean @default(false) @map("is_current")
  description  String? @db.VarChar(2000)

  @@index([resumeId])
  @@map("resume_experiences")
}

enum CompanyValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyProfile {
  jobs        Job[]
  // Nullable only for legacy profiles created before company registration existed.
  cnpj        String?            @unique @db.VarChar(14)
  legalName   String?            @map("legal_name") @db.VarChar(200)
  tradeName   String?            @map("trade_name") @db.VarChar(200)
  city        String?            @db.VarChar(100)
  state       String?            @db.VarChar(2)
  contactName String?            @map("contact_name") @db.VarChar(150)
  contactRole String?            @map("contact_role") @db.VarChar(100)
  phone       String?            @db.VarChar(11)
  validation  CompanyValidation?

  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_profiles")
}

model CompanyValidation {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @unique @map("company_id") @db.Uuid
  company         CompanyProfile          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          CompanyValidationStatus @default(PENDING)
  rejectionReason String?                 @map("rejection_reason") @db.Text
  reviewedById    String?                 @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?                   @relation("ValidationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("company_validations")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum JobStatus {
  OPEN
  CLOSED
}

enum JobContract {
  APPRENTICESHIP
  INTERNSHIP
  FORMAL_EMPLOYMENT
}

enum WorkRegime {
  ONSITE
  HYBRID
  REMOTE
}

enum JobArea {
  ADMINISTRATION
  SALES
  TECHNOLOGY
  LOGISTICS
  INDUSTRY
  HEALTH
  EDUCATION
  OTHER
}

model Job {
  id           String         @id @default(uuid()) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  company      CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String         @db.VarChar(150)
  description  String         @db.VarChar(5000)
  requirements String         @db.VarChar(5000)
  city         String         @db.VarChar(100)
  state        String         @db.VarChar(2)
  area         JobArea
  contract     JobContract
  regime       WorkRegime
  deadline     DateTime       @db.Date
  status       JobStatus      @default(OPEN)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId, createdAt, id])
  @@index([status, deadline])
  @@map("jobs")
}
