# Configure os valores locais antes de iniciar o banco. Não use este arquivo em produção.
POSTGRES_DB=conecta_jovem
POSTGRES_USER=conecta
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Preencha a senha escolhida acima na URL (com percent-encoding, quando necessário).
DATABASE_URL=postgresql://conecta:SENHA_LOCAL@localhost:5432/conecta_jovem?schema=public
API_PORT=3333
NODE_ENV=development
# URL explícita para E2E. Cada execução usa um schema test_<uuid> exclusivo.
# Pode apontar para o PostgreSQL local; nunca configure um banco de produção.
TEST_DATABASE_URL=

# Número de proxies reversos confiáveis (0 localmente; normalmente 1 na hospedagem).
# Em NODE_ENV=production a API exige HTTPS e o cookie de sessão usa Secure.
TRUST_PROXY_HOPS=0
# ADMIN_EMAIL e ADMIN_PASSWORD são fornecidos somente ao comando admin:create.
# Não mantenha a senha do administrador em arquivos versionados.
