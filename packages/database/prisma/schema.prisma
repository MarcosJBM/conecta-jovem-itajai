generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  YOUTH
  COMPANY
  ADMIN
}

model User {
  id                  String              @id @default(uuid()) @db.Uuid
  email               String              @unique @db.VarChar(254)
  passwordHash        String              @map("password_hash") @db.VarChar(255)
  role                UserRole
  youthProfile        YouthProfile?
  companyProfile      CompanyProfile?
  reviewedValidations CompanyValidation[] @relation("ValidationReviewer")
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

model YouthProfile {
  firstName    String?
  lastName     String?
  birthDate    DateTime? @db.Date
  phone        String?
  cpf          String?   @unique @db.VarChar(11)
  postalCode   String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("youth_profiles")
}

enum CompanyValidationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyProfile {
  // Nullable only for legacy profiles created before company registration existed.
  cnpj        String?            @unique @db.VarChar(14)
  legalName   String?            @map("legal_name") @db.VarChar(200)
  tradeName   String?            @map("trade_name") @db.VarChar(200)
  city        String?            @db.VarChar(100)
  state       String?            @db.VarChar(2)
  contactName String?            @map("contact_name") @db.VarChar(150)
  contactRole String?            @map("contact_role") @db.VarChar(100)
  phone       String?            @db.VarChar(11)
  validation  CompanyValidation?

  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("company_profiles")
}

model CompanyValidation {
  id              String                  @id @default(uuid()) @db.Uuid
  companyId       String                  @unique @map("company_id") @db.Uuid
  company         CompanyProfile          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  status          CompanyValidationStatus @default(PENDING)
  rejectionReason String?                 @map("rejection_reason") @db.Text
  reviewedById    String?                 @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?                   @relation("ValidationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt      DateTime?               @map("reviewed_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("company_validations")
}
