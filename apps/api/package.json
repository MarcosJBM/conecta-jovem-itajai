{
  "name": "@conecta/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@conecta/database": "workspace:*",
    "bcryptjs": "^3.0.3",
    "dotenv": "18.0.5",
    "express": "5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
