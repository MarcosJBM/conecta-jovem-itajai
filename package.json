{
  "name": "conecta-jovem-itajai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm db:generate && pnpm --filter @conecta/database build && turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "db:up": "node scripts/docker.mjs compose up -d postgres",
    "db:down": "node scripts/docker.mjs compose down",
    "db:reset": "node scripts/docker.mjs compose down --volumes",
    "db:logs": "node scripts/docker.mjs compose logs -f postgres",
    "db:status": "node scripts/docker.mjs compose ps",
    "db:generate": "pnpm --filter @conecta/database db:generate",
    "db:migrate": "pnpm --filter @conecta/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @conecta/database db:migrate:deploy",
    "db:validate": "pnpm --filter @conecta/database db:validate",
    "db:test": "pnpm --filter @conecta/database test:integration",
    "lint": "turbo lint",
    "test:unit": "turbo test:unit",
    "test:e2e": "turbo test:e2e",
    "format": "pnpm --filter @conecta/api format",
    "format:check": "pnpm --filter @conecta/api format:check",
    "lint:fix": "pnpm --filter @conecta/api --filter @conecta/web lint:fix"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "turbo": "2.11.7",
    "typescript": "5.9.3"
  }
}
