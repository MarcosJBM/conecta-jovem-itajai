{
  "name": "@conecta/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "pnpm build && node --test tests/*.test.mjs",
    "test:resume": "pnpm build && node --test tests/isolated/resume.integration.test.mjs",
    "db:seed": "pnpm build && prisma db seed",
    "test:seed": "pnpm build && node --test tests/seed.test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.5",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@brazilian-utils/brazilian-utils": "2.5.0",
    "@faker-js/faker": "10.6.0",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "bcryptjs": "3.0.3",
    "prisma": "7.10.0",
    "typescript": "5.9.3"
  }
}
